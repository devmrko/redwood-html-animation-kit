# OpenAI-compatible provider. Read on the local server only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4.1-nano
# An existing OPENROUTER_API key is also supported; set only one key.

# Optional OCI CLI defaults; credentials stay in ~/.oci/config.
OCI_CLI_PROFILE=DEFAULT
OCI_AI_REGION=ap-seoul-1
OCI_AI_MODEL=
OCI_AI_COMPARTMENT_ID=
# Exact compartment name can be used instead of its OCID. OCID takes precedence.
OCI_AI_COMPARTMENT_NAME=
OCI_AI_API_FORMAT=GENERIC
# OCI_CLI_CONFIG_FILE=~/.oci/config
