{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ES2022.Intl"
    ],
    "rootDir": "src",
    "outDir": "../vendor/foundation",
    "declaration": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
